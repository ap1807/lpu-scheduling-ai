# SQLite database location (relative to project root)
DATABASE_URL=file:./db/custom.db

# NextAuth session signing secret — generate your own:
#   openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-random-32-byte-base64-string

# Python analysis sidecar (optional — stage 1: health bridge)
# Server-side only; the browser can never see these values.
PYTHON_SERVICE_URL=http://127.0.0.1:8000
PYTHON_SERVICE_TIMEOUT_MS=2000
